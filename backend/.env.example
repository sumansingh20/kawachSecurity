# ================================
# KAVACH-INFINITY Backend Config
# ================================

# Server
PORT=3000
NODE_ENV=development
APP_NAME=KAVACH-INFINITY
APP_ENV=local

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kavach_infinity
DB_POOL_LIMIT=10
DB_CONNECT_TIMEOUT=10000

# JWT
JWT_SECRET=c8d6f590da6de8a7b706392148e06420d2ad73278dad2331dc8978cf824a618392743b61df4b217be2d07e30545283d1f731c6bc3e371d23513460bad147d893
JWT_EXPIRES_IN=24h

# Session
SESSION_SECRET=9b3ce161b5ce6fe81a526ad9fe4715ea62eca7d5b31ee3c4acce286f73132a03a16c519c71a0c9a0ac6abebc24f2d8a6afdf5dd19997f7e49cca40b618858795
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax

# Security
BCRYPT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=15
PASSWORD_MIN_LENGTH=8
REQUIRE_STRONG_PASSWORD=true

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Logging & Audit
LOG_LEVEL=info
ENABLE_AUDIT_LOGS=true

# CORS
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
ALLOW_CREDENTIALS=true